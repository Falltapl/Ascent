# ── Canvas (UT Arlington) ─────────────────────────────────────────────
# Account > Settings > Approved Integrations > "+ New Access Token"
# If UTA blocks student tokens, leave this blank and use CANVAS_ICS_URL.
CANVAS_BASE_URL=https://uta.instructure.com
CANVAS_TOKEN=

# Fallback / supplement: Canvas > Calendar > "Calendar Feed" link.
# Read-only, no token required, works even if tokens are disabled.
CANVAS_ICS_URL=

# ── Credly (AWS certification badges) ─────────────────────────────────
# The <handle> in credly.com/users/<handle>. Public, no auth needed.
CREDLY_HANDLE=

# ── Apple Calendar (read-only, v1) ────────────────────────────────────
# Calendar.app > right-click a calendar > Share Calendar > Public Calendar,
# then paste the webcal:// URL here (it will be converted to https).
APPLE_CALENDAR_ICS_URL=

# ── Assistant ─────────────────────────────────────────────────────────
# Set either or both. With both set, you can switch providers in the Ask tab.
# Install without it touching your screen:  npm run token ANTHROPIC_API_KEY
#
# Gemini — aistudio.google.com/apikey (has a free tier)
GEMINI_API_KEY=
# Override the Gemini model if you want a cheaper or newer one.
GEMINI_MODEL=

# Claude — console.anthropic.com/settings/keys (pay as you go)
ANTHROPIC_API_KEY=

# Which to prefer when both are set: claude | gemini
ASSISTANT_PROVIDER=

# ── School email (Microsoft 365 / Outlook) ────────────────────────────
# Microsoft killed password-based IMAP for M365, so this needs OAuth.
# Register a free app at https://portal.azure.com → App registrations:
#   • Supported accounts: "Accounts in any organizational directory"
#   • Authentication → Allow public client flows: YES
#   • API permissions → Microsoft Graph → Delegated → Mail.Read, offline_access
# Then paste the Application (client) ID here.
GRAPH_CLIENT_ID=
# "common" works for most; use UTA's tenant id if your admin requires it:
# 5cdc5b43-d7be-4caa-8173-729e3b0a62d9
GRAPH_TENANT=common

# ── Server ────────────────────────────────────────────────────────────
PORT=8787
